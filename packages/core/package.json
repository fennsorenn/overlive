{
  "name": "@overlive/core",
  "version": "0.3.0",
  "description": "Unified live stream meta-event SDK — core runtime",
  "license": "UNLICENSED",
  "author": "fennsorenn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fennsorenn/overlive.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@overlive/tsconfig": "workspace:*",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
